# =============================================================================
# TEAM ALPHA - Disaster Alert System Environment Variables Template
# =============================================================================
#
# Copy this file to '.env' and fill in the values.
#
# CRITICAL SECURITY WARNING:
# - NEVER commit the actual '.env' file containing secrets to version control.
# - The variables defined below are SERVER-SIDE ONLY.
# - NEVER expose these values via client-side frontend code or client configs.
# =============================================================================

# Firebase Admin SDK Configuration
# Paste the JSON private key as a single-line string here
FIREBASE_SERVICE_ACCOUNT='{ "type": "service_account", "project_id": "YOUR_PROJECT_ID", "private_key": "-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY_HERE\\n-----END PRIVATE KEY-----\\n", "client_email": "YOUR_CLIENT_EMAIL" }'
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com

# Email Broadcasting Configuration (Brevo SMTP API Client)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_sender_email@domain.com

# API Protection Security Key
ALERT_API_KEY=your_admin_secret_key_here

# API Cron Authentication Secret
CRON_SECRET=your_cron_secret_key_here

# Google Places / Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# =============================================================================
# SECURE CRISISMESH AI INTEGRATION CONFIGURATION
# =============================================================================
# ENABLE_CRISIS_INTEGRATION: Set to "true" to enable secure server-to-server 
# alert forwarding to CrisisMesh. Set to "false" (or leave unset) to disable.
ENABLE_CRISIS_INTEGRATION=false

# CRISISMESH_API_URL: The base URL of the CrisisMesh AI backend API (e.g. http://localhost:3000)
# This is server-side only; never prefix it with VITE_ or expose to client JS.
CRISISMESH_API_URL=

# CRISIS_INTEGRATION_KEY: The shared secret Bearer token used to authenticate
# server-to-server requests to the CrisisMesh backend.
# KEEP THIS KEY SECRET. Never expose it to the browser.
CRISIS_INTEGRATION_KEY=
