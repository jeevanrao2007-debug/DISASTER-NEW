{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "api/alert.js": {
      "maxDuration": 10
    },
    "api/runtime-config.js": {
      "maxDuration": 5
    },
    "api/nearby-resources.js": {
      "maxDuration": 10
    },
    "api/dispatch-alert.js": {
